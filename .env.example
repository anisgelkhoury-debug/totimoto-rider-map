# Local-only. Do not commit real secret values.
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_VAPID_KEY=

# Optional override for local Functions emulator weather proxy.
# Example: http://127.0.0.1:5001/totimoto-rider-network/us-central1/getRiderWeather
# VITE_WEATHER_PROXY_URL=

# TRN 057D — bounded geo report queries (default OFF / absent = full listener).
# VITE_USE_BOUNDED_REPORT_QUERIES=false
# DEV-only comparison diagnostics (default OFF):
# VITE_COMPARE_BOUNDED_REPORT_QUERIES=false

# Server secret (Functions only — never a VITE_ client variable):
# WEATHERAPI_KEY
